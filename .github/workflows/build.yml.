name: Build GBA ROM

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    container: devkitpro/devkitarm
    steps:
      - uses: actions/checkout@v4
      - name: Compile
        run: |
          export PATH=$DEVKITARM/bin:/opt/devkitpro/tools/bin:$PATH
          arm-none-eabi-gcc -mthumb -mthumb-interwork -O2 -Wall -specs=gba.specs main.c -o game.elf
          arm-none-eabi-objcopy -O binary game.elf game.gba
          gbafix game.gba -tBQPROTO
      - uses: actions/upload-artifact@v4
        with:
          name: game-gba
          path: game.gba
